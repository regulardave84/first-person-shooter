{
	"name": "first-person-shooter",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest run -c vitest.config.ts",
		"test:unit": "vitest run -c vitest.config.ts",
		"test:acceptance": "vitest run -c vitest.acceptance.config.ts",
		"test:all": "npm run test:unit && npm run test:acceptance",
		"test:watch": "vitest -c vitest.config.ts",
		"test:watch:acceptance": "vitest -c vitest.acceptance.config.ts",
		"test:coverage": "vitest run --coverage",
		"test:coverage:cleaner": "vitest run --coverage --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.statements=0 --coverage.thresholds.branches=0 --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=json",
		"test:mutation": "stryker run",
		"test:mutation:branch": "node scripts/hardener-branch-mutation.mjs",
		"deps:check": "node scripts/dependency-checker.mjs",
		"analyze:crap": "node scripts/cleaner-crap.mjs",
		"cleaner:dependency-gate": "npm run deps:check",
		"cleaner": "npm run test:coverage:cleaner && npm run analyze:crap && npm run cleaner:dependency-gate",
		"prepare": "husky"
	},
	"dependencies": {
		"three": "^0.170.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@stryker-mutator/core": "^8.7.1",
		"@types/three": "^0.187.0",
		"@vitest/coverage-v8": "^4.1.12",
		"eslint": "^9.39.5",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"typescript": "^5.6.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^5.4.10",
		"vitest": "^4.1.12"
	}
}
